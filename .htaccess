# Apache / LiteSpeed (cPanel, MilesWeb, Hostinger). Ignored by GitHub Pages.
Options -Indexes
DirectoryIndex index.html

# Always load the latest stock data and scripts
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json
</IfModule>
